00:00","team_to_id":1136,"player_id":31187,"team_from_id":370,"source_type":2,"source_url":"https://www.facebook.com/ENTERPRISEesports/posts/334485344888497","action_date":"2021-08-03","action_type":1,"compensation":null,"team_to_name":"ENTERPRISE esports","team_from_name":"BRUTE","player_name":"MATYS","discipline_id":1,"player_country":null,"is_coach":false},{"id":34258,"created_at":"2022-05-01T17:24:24.019+00:00","updated_at":"2022-06-05T18:34:27.312+00:00","team_to_id":1200,"player_id":31187,"team_from_id":1136,"source_type":2,"source_url":"https://twitter.com/teamsampi/status/1520795187441815552","action_date":"2022-05-01","action_type":1,"compensation":null,"team_to_name":"Team Sampi","team_from_name":"ENTERPRISE esports","player_name":"matys","discipline_id":1,"player_country":null,"is_coach":false},{"id":63274,"created_at":"2023-11-28T01:00:50.276+00:00","updated_at":"2023-11-30T08:39:42.137+00:00","team_to_id":786,"player_id":31187,"team_from_id":1200,"source_type":2,"source_url":"https://twitter.com/FNATICCS2/status/1729199531903037681","action_date":"2023-11-27","action_type":1,"compensation":null,"team_to_name":"Fnatic","team_from_name":"Team Sampi","player_name":"matys","discipline_id":1,"player_country":null,"is_coach":false},{"id":146482,"created_at":"2025-07-12T01:00:12.224+00:00","updated_at":"2025-07-12T01:00:12.224+00:00","team_to_id":null,"player_id":31187,"team_from_id":786,"source_type":2,"source_url":"https://x.com/FNATICCS2/status/1943704214602920412","action_date":"2025-07-11","action_type":3,"compensation":null,"team_to_name":null,"team_from_name":"Fnatic","player_name":"matys","discipline_id":1,"player_country":null,"is_coach":false},{"id":146675,"created_at":"2025-07-19T01:01:07.998+00:00","updated_at":"2025-07-19T05:32:37.068+00:00","team_to_id":793,"player_id":31187,"team_from_id":null,"source_type":2,"source_url":"https://x.com/g2csgo/status/1946208491397321060","action_date":"2025-07-18","action_type":1,"compensation":null,"team_to_name":"G2 Esports","team_from_name":null,"player_name":"matys","discipline_id":1,"player_country":null,"is_coach":false}]}],"country":{"id":30,"code":"DE","name":"Germany","region_id":3,"region":{"id":3,"slug":"europe","name":"Europe","flag":"","position":null}},"tags":[{"id":49,"name":"G2 Esports","slug":"g2-esports","team_id":793}],"localized_teams_records":[{"id":37,"team_id":793,"title":"G2 info","body":{"time":1732272963958,"blocks":[{"id":"e-HK7FUbP9","data":{"text":"G2 is a top esports organization based in Berlin, Germany. Founded in 2013 by former LOL player ocelote, G2 became one of the big names in gaming. Their first attempt in CSGO was with a Polish roster. Since then, G2 has changed and developed, and now built one of the strongest lineups in Counter-Strike 2."},"type":"paragraph","tunes":{}},{"id":"t3mZOimQ3G","data":{"text":"The great results didn't come overnight, but their first big break happened in 2015 when they made it to the semifinals of DreamHack Open Cluj-Napoca where they lost to the future Major champions EnVyUs. In 2016, they signed the former Titan roster. The French lineup helped G2 win tournaments like ESL Pro League Season 5 and DreamHack Masters Malmö 2017."},"type":"paragraph","tunes":{}},{"id":"iYkMINpQwe","data":{"text":"At PGL Major Stockholm 2021, the team reached its second Major final, but lost it to NAVI. Most of the fans remember NiKo’s unfortunate Deagle miss from Heaven on Nuke. This moment could save the game! A year later, G2 team finally won a notable international LAN event after years of waiting. They were the best at BLAST Premier World Final 2022, which was held in Abu Dhabi, and earned $500,000 of prize money. Later, in 2023, the organization became the third one ever to win both IEM Katowice and IEM Cologne in one year (after FaZe and fnatic).\u0026nbsp;"},"type":"paragraph","tunes":{}},{"id":"jHBPvTvW1I","data":{"text":"The G2 roster has seen many changes over time. Today, G2 players include some of the best talents in the game. NiKo, huNter-, m0NESY, and others are key players in G2 matches, helping the team achieve big wins. The roster also features the legend of the game Snax, who joined in 2024 as the IGL. His long time friend and teammate TaZ joined G2 in 2023 as a coach."},"type":"paragraph","tunes":{}},{"id":"nR8kBNbVeT","data":{"text":"In 2024, G2 entered Counter-Strike 2 with high hopes. They continued to perform well, winning events like IEM Dallas and Blast Premier Fall Final. The G2 CS2 roster proved to be strong, and the team adapted well to the new game. G2’s players have shown great teamwork and skill, making them one of the top contenders in every tournament they participate in."},"type":"paragraph","tunes":{}},{"id":"JAectNlegJ","data":{"text":"G2 Esports as the organization is ready to make big and aggressive moves. Sometimes they are too risky in the cases like NiKo and m0NESY signings. But the risk doesn’t matter if the reward is high in the end and brings the club to the new level at the Counter-Strike scene."},"type":"paragraph","tunes":{}}],"version":"2.25.0"},"locale":"en","created_at":"2024-11-22T10:55:47.904+00:00","updated_at":"2024-11-22T10:56:05.349+00:00","scope":null}]}