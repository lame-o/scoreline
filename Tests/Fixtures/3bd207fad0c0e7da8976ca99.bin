Brewers complete comeback","shortDescription":"Cooper Pratt's go-ahead RBI single helps Brewers complete comeback","lastModified":"2026-10-25T05:02:47Z","originalPublishDate":"2026-10-25T03:27:04Z","premium":false,"syndicatable":true,"duration":21,"videoRatio":"16:9","timeRestrictions":{"embargoDate":"2026-10-25T03:26:56Z","expirationDate":"2026-10-27T03:26:00Z"},"deviceRestrictions":{"devices":["settop","tablet","handset","ipad","desktop"],"type":"whitelist"},"geoRestrictions":{"countries":["PR","HN","PY","HT","AG","ZA","AI","AO","AR","AS","RE","ZM","AU","AW","BB","JM","BF","RW","BI","BJ","BL","BM","BO","BQ","SC","SD","BS","BW","BZ","SL","KE","SN","SO","SS","CD","ST","KM","KN","CF","SV","CG","SX","CI","SZ","CL","CM","CO","KY","TC","CR","TD","CU","CV","TG","LC","TT","DJ","TZ","LR","LS","DO","UG","UK","UM","MF","MG","EC","US","ML","MP","MQ","UY","MR","MS","MU","MV","MW","MX","ER","MZ","VC","VE","VG","VI","NA","NE","NG","NI","NL","FK","NZ","GA","GB","GD","GH","GM","GN","GP","GQ","GT","GU","GW","PA","GY","PE"],"type":"whitelist"},"gameId":401908043,"plays":[{"id":4019080431303990057}],"thumbnail":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/1025/ss_20261024_232706630_371039062/ss_20261024_232706630_371039062.jpg","images":[{"name":"Poster Image","caption":"","alt":"","credit":"","height":324,"width":576,"url":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/1025/ss_20261024_232706630_371039062/ss_20261024_232706630_371039062.jpg"}],"posterImages":{"default":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/1025/ss_20261024_232706630_371039062/ss_20261024_232706630_371039062_default.jpg","width":576,"height":324},"firstFrame":{"href":"https://cmp-espn.media.dssott.com/opp/img/espn/2026/1024/ss_20261024_232706630_3710390/ss_20261024_232706630_3710390/thumb-1-w720-h406-f4.jpg"},"full":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/1025/ss_20261024_232706630_371039062/ss_20261024_232706630_371039062.jpg"},"square":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/1025/ss_20261024_232706630_371039062/ss_20261024_232706630_371039062_1x1.jpg"},"wide":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/common/2026/1025/ss_20261024_232706630_371039062/ss_20261024_232706630_371039062_5x2.jpg"}},"links":{"api":{"artwork":{"href":"https://artwork.api.espn.com/artwork/collections/media/b860026d-1847-48ab-b96d-18cb23ace1e3"},"self":{"href":"https://content.core.api.espn.com/v1/video/clips/50273577"}},"mobile":{"href":"https://watch.auth.api.espn.com/video/auth/brightcove/b860026d-1847-48ab-b96d-18cb23ace1e3/asset?UMADPARAMreferer=https://www.espn.com/video/clip/_/id/50273577/cooper-pratt-go-ahead-rbi-single-helps-brewers-complete-comeback","alert":{"href":"https://m.espn.com/general/video/videoAlert?vid=50273577"},"progressiveDownload":{"href":"https://watch.auth.api.espn.com/video/auth/brightcove/b860026d-1847-48ab-b96d-18cb23ace1e3/asset?UMADPARAMreferer=https://www.espn.com/video/clip/_/id/50273577/cooper-pratt-go-ahead-rbi-single-helps-brewers-complete-comeback"},"source":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/2026/1024/ss_20261024_232706630_3710390/ss_20261024_232706630_3710390.mp4"},"streaming":{"href":"https://watch.auth.api.espn.com/video/auth/brightcove/b860026d-1847-48ab-b96d-18cb23ace1e3/asset?UMADPARAMreferer=https://www.espn.com/video/clip/_/id/50273577/cooper-pratt-go-ahead-rbi-single-helps-brewers-complete-comeback"}},"source":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/2026/1024/ss_20261024_232706630_3710390/ss_20261024_232706630_3710390.mp4","HD":{"href":"https://espnmedia-cdn.akamaized.net/espn/media/16x9/2026/1024/ss_20261024_232706630_3710390/ss_20261024_232706630_3710390.mp4"},"HLS":{"href":"https://cmp-espn.media.dssott.com/opp/hls/espn/2026/1024/ss_20261024_232706630_3710390/ss_20261024_232706630_3710390/playlist.m3u8","HD":{"href":"https://cmp-espn.media.dssott.com/opp/hls/espn/2026/1024/ss_20261