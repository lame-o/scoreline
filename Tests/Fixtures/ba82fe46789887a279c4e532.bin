try":null,"is_coach":true},{"id":82978,"created_at":"2024-12-02T12:44:24.979+00:00","updated_at":"2024-12-02T12:44:24.979+00:00","team_to_id":null,"player_id":30649,"team_from_id":null,"source_type":2,"source_url":"http://www.flipsidetactics.com/news/f3-csgo-restructuring/","action_date":"2018-07-19","action_type":1,"compensation":null,"team_to_name":"FlipSid3 Tactics","team_from_name":"FlipSid3 Tactics","player_name":"B1ad3","discipline_id":1,"player_country":null,"is_coach":true},{"id":82999,"created_at":"2024-12-02T12:44:26.674+00:00","updated_at":"2024-12-02T12:44:26.674+00:00","team_to_id":787,"player_id":30649,"team_from_id":787,"source_type":2,"source_url":"https://navi.gg/en/read/text/4613-new-natus-vincere-csgo-roster","action_date":"2019-09-20","action_type":1,"compensation":null,"team_to_name":"Natus Vincere","team_from_name":"Natus Vincere","player_name":"B1ad3","discipline_id":1,"player_country":null,"is_coach":true},{"id":160182,"created_at":"2025-07-31T03:51:38.753+00:00","updated_at":"2025-07-31T03:51:38.753+00:00","team_to_id":787,"player_id":30649,"team_from_id":null,"source_type":null,"source_url":null,"action_date":"2019-03-30","action_type":1,"compensation":null,"team_to_name":"Natus Vincere","team_from_name":null,"player_name":"B1ad3","discipline_id":1,"player_country":null,"is_coach":false},{"id":160205,"created_at":"2025-07-31T03:51:40.695+00:00","updated_at":"2025-07-31T03:51:40.695+00:00","team_to_id":null,"player_id":30649,"team_from_id":null,"source_type":null,"source_url":null,"action_date":"2019-03-17","action_type":3,"compensation":null,"team_to_name":null,"team_from_name":"Gambit Esports","player_name":"B1ad3","discipline_id":1,"player_country":null,"is_coach":true}]},{"id":37543,"slug":"makazze","nickname":"makazze","first_name":"Drin","last_name":"Shaqiri","status":1,"birthday":"2006-12-21","role":null,"twitter":null,"twitch":null,"facebook":null,"image_url":"https://files.bo3.gg/uploads/player/37543/image/webp-3563f398f4feb850209ebaf8a5e92eb7.webp","country_id":36,"team_id":787,"discipline_id":1,"six_month_avg_rating":6.135250684746654,"is_coach":false,"coach_status":null,"total_prize":200061.0,"gallery_presence":true,"settings_presence":true,"gears_presence":true,"comments_count":0,"country":{"id":36,"code":"XK","name":"Kosovo","region_id":3,"region":{"id":3,"slug":"europe","name":"Europe","flag":"","position":null}},"player_transfers":[{"id":41260,"created_at":"2023-07-20T01:00:22.508+00:00","updated_at":"2023-08-09T16:55:31.129+00:00","team_to_id":5709,"player_id":37543,"team_from_id":null,"source_type":2,"source_url":"https://twitter.com/gejmzilla/status/1679943507870466051","action_date":"2023-07-14","action_type":1,"compensation":null,"team_to_name":"KS-","team_from_name":null,"player_name":"makazze","discipline_id":1,"player_country":null,"is_coach":false},{"id":46492,"created_at":"2023-09-05T01:00:31.483+00:00","updated_at":"2024-02-05T13:07:19.866+00:00","team_to_id":null,"player_id":37543,"team_from_id":5709,"source_type":2,"source_url":"https://twitter.com/KSteam0/status/1698422389564920030","action_date":"2023-09-03","action_type":3,"compensation":null,"team_to_name":null,"team_from_name":"KS-","player_name":"makazze","discipline_id":1,"player_country":null,"is_coach":false},{"id":62116,"created_at":"2023-10-16T01:00:31.350+00:00","updated_at":"2024-02-05T13:07:28.652+00:00","team_to_id":441,"player_id":37543,"team_from_id":null,"source_type":2,"source_url":"https://navi.gg/en/publications/csjunior-new-roster-october-23","action_date":"2023-10-15","action_type":1,"compensation":null,"team_to_name":"Natus Vincere Junior","team_from_name":null,"player_name":"makazze","discipline_id":1,"player_country":null,"is_coach":false},{"id":69132,"created_at":"2024-05-21T01:01:18.782+00:00","updated_at":"2024-05-21T06:34:11.577+00:00","team_to_id":441,"player_id":37543,"team_from_id":441,"source_type":2,"source_url":"https://navi.gg/en/publications/csjun-navi-academy-restructuring","action_date":"2024-05-20","action_type":2,"compensation":null,"team_to_name":"Natus Vincere Junior","team_from_name":"Natus Vincere Junior","player_name":"makazze","discipline_id":1,"player_country":"Kosovo","is_coach":false},{"id":146379,"created_at":"2025-07-09T01:00:21.018+00:00","updated_at":"2025-07-09T06:04:14.921+00:00","team_to_id":787,"player_id":37543,"team_from_id":441,"source_type":2,"source_url":"https://navi.gg/en/publications/jl-takes-a-career-break","action_date":"2025-07-08","action_type":1,"compensation":null,"team_to_name":"Natus Vincere","team_from_name":"Natus Vincere Junior","player_name":"makazze","discipline_id":1,"player_country":null,"is_coach":false}]}],"country":{"id":58,"code":"UA","name":"Ukraine","region_id":3,"region":{"id":3,"slug":"europe","name":"Europe","flag":"","position":null}},"tags":[{"id":751,"name":"Natus Vincere","slug":"natus-vincere","team_id":787}],"localized_teams_records":[{"id":46,"team_id":787,"title":"Navi info","body":{"time":1732520554529,"blocks":[{"id":"aMuhEXFX5z","data":{"text":"Natus Vincere (NAVI) were founded in 2009 with the support of Murat “Arbalet” Zhumashevich, who initially believed in the potential of esports. The first NAVI roster was nicknamed “golden” due to their incredible achievements in 2010: the team won 12 medals, 8 of which were gold. The transition to CS:GO did not change the lineup, but more than half a year later the reshuffle began, which gave the start of a new history of the NAVI team."},"type":"paragraph","tunes":{}},{"id":"WwBfp6dvo9","data":{"text":"The brightest page in CS:GO for NAVI was winning the PGL Major in Stockholm in 2021. This was the organization's first major success at a major in CS:GO.\u0026nbsp; The team consisting of s1mple, b1t, electronic, Perfecto, and Boombl4 displayed a dominant performance, not losing a single map throughout the entire tournament. This victory cemented NAVI as one of the greatest teams in CS:GO history and continued the era.\u0026nbsp;"},"type":"paragraph","tunes":{}},{"id":"ROgvDsoK6r","data":{"text":"In mid-2023, NAVI decided to change their approach by forming an international roster. The revamped team included AleksiB, jL, iM, b1t, and s1mple. However, towards the end of the year there were changes: the legendary s1mple was replaced by a young talent w0nderful, who quickly fit into the team and began to show impressive results."},"type":"paragraph","tunes":{}},{"id":"hgW7dm1wky","data":{"text":"Currenti NAVI CS2 is the best team in the world. They confirmed this title at the first ever CS2 Major, where NAVI sensationally became champions. For many it was a shock, but since then the team demonstrates a consistently high level of play, reaching the finals of almost every major tournament."},"type":"paragraph","tunes":{}},{"id":"DjMHJDMAgP","data":{"text":"Special mention should be made of the NAVI coach - b1ad3. His contribution to the success of the team cannot be overestimated. He managed to bring two different squads to the top, turning unknown players into real stars. The NAVI stats highlight the incredible play of individual players under b1ad3's leadership, keeping the team at the top of the world stage.\u0026nbsp;NAVI's busy schedule leaves the team little time to rest. Nevertheless, regular participation in major tournaments only reinforces their status as champions"},"type":"paragraph","tunes":{}}],"version":"2.25.0"},"locale":"en","created_at":"2024-11-25T07:42:12.233+00:00","updated_at":"2024-11-25T07:42:36.752+00:00","scope":null}]}