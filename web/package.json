{
	"name": "scoreline-web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "NODE_OPTIONS=\"--experimental-strip-types --disable-warning=ExperimentalWarning\" cf dev",
		"build": "NODE_OPTIONS=\"--experimental-strip-types --disable-warning=ExperimentalWarning\" cf build",
		"preview": "NODE_OPTIONS=\"--experimental-strip-types --disable-warning=ExperimentalWarning\" cf build && vite preview",
		"types": "NODE_OPTIONS=\"--experimental-strip-types --disable-warning=ExperimentalWarning\" cf workers types",
		"typecheck": "pnpm types && tsc -b",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"fixtures": "node scripts/record-fixtures.mjs",
		"deploy": "NODE_OPTIONS=\"--experimental-strip-types --disable-warning=ExperimentalWarning\" cf deploy"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@playwright/test": "^1.64.1",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"cf": "^1.0.0-beta.23",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@tanstack/react-query": "^5.105.0",
		"motion": "^14.6.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.0"
	},
	"description": "Scoreline for the web: live scores, on Cloudflare Workers.",
	"license": "MIT",
	"engines": {
		"node": ">=22.15"
	}
}
